{
  "openapi": "3.1.0",
  "info": {
    "title": "RAG backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness: the process is up and serving requests.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness: 200 once the stack can answer, else 503. Both carry every check.",
        "operationId": "getReady",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready: see `checks`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "description": "Answer one Turn, streamed as Server-Sent Events.\n\n`rewritten` (Follow-ups only) -> `passages` -> `token`s -> `done`, or `error` once the\nstream has started.",
        "operationId": "postChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/ChatStreamEvent"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Error codes: validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/ErrorBody"
                    }
                  },
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "title": "ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Error codes: llm_not_configured, index_not_ready, retrieval_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/ErrorBody"
                    }
                  },
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "title": "ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/ErrorBody"
                    }
                  },
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "title": "ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/articles": {
      "get": {
        "summary": "List Articles",
        "description": "Every Article in the Knowledge Base, with its Section outline.",
        "operationId": "listArticles",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ArticleSummary"
                  },
                  "type": "array",
                  "title": "Response Listarticles"
                }
              }
            }
          }
        }
      }
    },
    "/articles/{article_id}": {
      "get": {
        "summary": "Get Article",
        "description": "One full Article, split into its ordered Sections, for Citation click-through.",
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Article Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetail"
                }
              }
            }
          },
          "404": {
            "description": "Error codes: not_found",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/ErrorBody"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "title": "ErrorEnvelope",
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "type": {
            "type": "string",
            "const": "answer",
            "title": "Type",
            "default": "answer"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieved_passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Retrieved Passages"
          },
          "standalone_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standalone Question"
          }
        },
        "type": "object",
        "required": [
          "text",
          "citations",
          "retrieved_passages",
          "standalone_question"
        ],
        "title": "Answer"
      },
      "ArticleDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "applies_to": {
            "items": {
              "type": "string",
              "enum": [
                "v2",
                "v3"
              ]
            },
            "type": "array",
            "title": "Applies To"
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "deprecated"
            ],
            "title": "Status"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/ArticleSection"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "applies_to",
          "status",
          "sections"
        ],
        "title": "ArticleDetail"
      },
      "ArticleRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "ArticleRef"
      },
      "ArticleSection": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Path"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          }
        },
        "type": "object",
        "required": [
          "id",
          "path",
          "level",
          "markdown"
        ],
        "title": "ArticleSection"
      },
      "ArticleSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "applies_to": {
            "items": {
              "type": "string",
              "enum": [
                "v2",
                "v3"
              ]
            },
            "type": "array",
            "title": "Applies To"
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "deprecated"
            ],
            "title": "Status"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionSummary"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "applies_to",
          "status",
          "sections"
        ],
        "title": "ArticleSummary"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Answer"
          },
          {
            "$ref": "#/components/schemas/UncitedAnswer"
          },
          {
            "$ref": "#/components/schemas/Refusal"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "answer": "#/components/schemas/Answer",
            "refusal": "#/components/schemas/Refusal",
            "uncited_answer": "#/components/schemas/UncitedAnswer"
          }
        }
      },
      "ChatStreamEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RewrittenEvent"
          },
          {
            "$ref": "#/components/schemas/PassagesEvent"
          },
          {
            "$ref": "#/components/schemas/TokenEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "done": "#/components/schemas/DoneEvent",
            "error": "#/components/schemas/ErrorEvent",
            "passages": "#/components/schemas/PassagesEvent",
            "rewritten": "#/components/schemas/RewrittenEvent",
            "token": "#/components/schemas/TokenEvent"
          }
        }
      },
      "Check": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "Check"
      },
      "Citation": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N"
          },
          "passage": {
            "$ref": "#/components/schemas/Passage"
          }
        },
        "type": "object",
        "required": [
          "n",
          "passage"
        ],
        "title": "Citation"
      },
      "DoneEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type",
            "default": "done"
          },
          "result": {
            "$ref": "#/components/schemas/ChatResult"
          }
        },
        "type": "object",
        "required": [
          "result"
        ],
        "title": "DoneEvent",
        "description": "The authoritative result. It replaces all provisional text streamed before it."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_error",
          "not_found",
          "method_not_allowed",
          "llm_not_configured",
          "llm_auth_failed",
          "llm_unavailable",
          "llm_timeout",
          "rewrite_failed",
          "index_not_ready",
          "retrieval_unavailable",
          "internal_error"
        ]
      },
      "ErrorEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type",
            "default": "error"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEvent",
        "description": "A failure after the stream has started, when the HTTP status has already gone out."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HistoryTurn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 20000,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "HistoryTurn",
        "description": "An earlier Turn of the Conversation, as the client remembers it."
      },
      "LlmCheck": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LlmProblem"
              },
              {
                "type": "null"
              }
            ]
          },
          "command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "LlmCheck"
      },
      "LlmProblem": {
        "type": "string",
        "enum": [
          "auth_failed",
          "unavailable",
          "model_missing"
        ]
      },
      "Passage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "article": {
            "$ref": "#/components/schemas/ArticleRef"
          },
          "section": {
            "$ref": "#/components/schemas/SectionRef"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "applies_to": {
            "items": {
              "type": "string",
              "enum": [
                "v2",
                "v3"
              ]
            },
            "type": "array",
            "title": "Applies To"
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "deprecated"
            ],
            "title": "Status"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "article",
          "section",
          "text",
          "applies_to",
          "status",
          "score"
        ],
        "title": "Passage"
      },
      "PassagesEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "passages",
            "title": "Type",
            "default": "passages"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Passages"
          }
        },
        "type": "object",
        "required": [
          "passages"
        ],
        "title": "PassagesEvent",
        "description": "The retrieved Passages, numbered in prompt order. Sent before any token."
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/Check"
          },
          "index": {
            "$ref": "#/components/schemas/Check"
          },
          "llm": {
            "$ref": "#/components/schemas/LlmCheck"
          }
        },
        "type": "object",
        "required": [
          "database",
          "index",
          "llm"
        ],
        "title": "ReadinessChecks"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "Refusal": {
        "properties": {
          "type": {
            "type": "string",
            "const": "refusal",
            "title": "Type",
            "default": "refusal"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_relevant_passages",
              "not_in_context"
            ],
            "title": "Reason"
          },
          "retrieved_passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Retrieved Passages"
          },
          "standalone_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standalone Question"
          }
        },
        "type": "object",
        "required": [
          "message",
          "reason",
          "retrieved_passages",
          "standalone_question"
        ],
        "title": "Refusal"
      },
      "RewrittenEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "rewritten",
            "title": "Type",
            "default": "rewritten"
          },
          "standalone_question": {
            "type": "string",
            "title": "Standalone Question"
          }
        },
        "type": "object",
        "required": [
          "standalone_question"
        ],
        "title": "RewrittenEvent",
        "description": "The Standalone Question a Follow-up Question was rewritten into. Follow-ups only."
      },
      "SectionRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "title": "SectionRef"
      },
      "SectionSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "title": "SectionSummary"
      },
      "TokenEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "token",
            "title": "Type",
            "default": "token"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TokenEvent",
        "description": "Raw model text. Its markers keep the prompt numbers from `passages`."
      },
      "UncitedAnswer": {
        "properties": {
          "type": {
            "type": "string",
            "const": "uncited_answer",
            "title": "Type",
            "default": "uncited_answer"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "retrieved_passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Retrieved Passages"
          },
          "standalone_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standalone Question"
          }
        },
        "type": "object",
        "required": [
          "text",
          "retrieved_passages",
          "standalone_question"
        ],
        "title": "UncitedAnswer",
        "description": "An Answer with no valid Citations, shown with a warning (ADR-0001)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
