# Copy to .env and adjust. No secrets belong in this file; your key goes only in .env.

# Host ports `pixi run up` publishes the services on.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
# Postgres is published on 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# The pgvector image Compose runs and the backend tests start (keep them the same).
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18-trixie

# Backend settings (pydantic-settings, prefix BACKEND_).
BACKEND_APP_NAME=RAG backend
# For `pixi run dev-backend` on the host; Compose points the backend at its `postgres` service.
# rag/rag are fixed local-only credentials, not a secret. Match the port to POSTGRES_HOST_PORT.
BACKEND_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Logs are JSON lines (`pixi run dev-backend` switches to a readable console format).
# DEBUG also logs each Turn's question and Answer text, which may contain client data.
# BACKEND_LOG_LEVEL=DEBUG
# Retrieval: Passages per question, and the dense cosine score below which the assistant refuses.
# `pixi run eval-retrieval` checks a change against the Golden Questions.
# BACKEND_RETRIEVAL_TOP_K=6
# BACKEND_RETRIEVAL_MIN_SCORE=0.66

# --- LLM: pick ONE of the two blocks. `pixi run check-config` validates your choice. ---

# Option A (default): Claude. Paste your key (read unprefixed, so an exported one works too).
ANTHROPIC_API_KEY=
# Optional: cheaper and faster than the default claude-opus-5-5.
# BACKEND_LLM_MODEL=claude-haiku-5-5

# Option B: keyless, a local model through Ollama (the first run downloads ~8 GB: image + model).
# Uncomment these two lines (the key above can stay empty):
# BACKEND_LLM_PROVIDER=ollama
# COMPOSE_PROFILES=ollama
# Mac: a native Ollama uses the Metal GPU, which a container can't. Run `ollama pull qwen3.5:2b`,
# drop COMPOSE_PROFILES above, and point the backend at it:
# BACKEND_OLLAMA_BASE_URL=http://host.docker.internal:11434
